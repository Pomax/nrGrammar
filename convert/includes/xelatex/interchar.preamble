% This file defines all the fonts that should be used for the various kinds of characters used,
% as well as the font-change rules that should occur when a transition from characters from
% one class to characters from another class are encountered.

% Load CJK character class assignments (needed because XeTeX doesn't auto-assign CJK to classes 1/2/3)
\input{includes/xelatex/cjk-classes.preamble}

% first off, the font definitions

\newfontfamily{\rmfont}{Palatino Linotype}[
	Path = ./fonts/,
	UprightFont = western/palatino/pala.ttf,
    ItalicFont = western/palatino/palai.ttf,
    BoldFont = western/palatino/palab.ttf,
    BoldItalicFont = western/palatino/palabi.ttf
]

\newfontfamily{\cjkfont}{Kozuka Mincho}[
	Path = ./fonts/,
	UprightFont = japanese/kozuka/KozMinPro-Regular.otf,
	BoldFont = japanese/kozuka/KozMinPro-Bold.otf
]

\newfontfamily{\cjkafont}{HAN NOM A}[
	Path = ./fonts/,
	UprightFont = han/han nom/HAN NOM A.ttf
]

\newfontfamily{\cjkbfont}{HAN NOM B}[
	Path = ./fonts/,
	UprightFont = han/han nom/HAN NOM B.ttf
]

\newfontfamily{\arrowfont}{HAN NOM B}[
	Path = ./fonts/,
	UprightFont = han/han nom/HAN NOM B.ttf
]

\newfontfamily{\strokefont}{MingLiu}[
	Path = ./fonts/,
	UprightFont = han/mingliu/mingliu.ttf
]

\newfontfamily{\quotefont}{Adobe Caslon Pro}[
	Path = ./fonts/,
	UprightFont = western/caslon/ACaslonPro-Regular.otf,
	BoldFont = western/caslon/ACaslonPro-Bold.otf,
	ItalicFont = western/caslon/ACaslonPro-Italic.otf,
	BoldItalicFont = western/caslon/ACaslonPro-BoldItalic.otf,
]

\newfontfamily{\extlatinfont}{FreeSerif}[
	Path = ./fonts/,
	UprightFont = western/freefont/FreeSerif.otf,
    ItalicFont = western/freefont/FreeSerifItalic.otf,
    BoldFont = western/freefont/FreeSerifBold.otf,
    BoldItalicFont = western/freefont/FreeSerifBoldItalic.otf
]

\newfontfamily{\vparens}{FreeSerif}[
	Path = ./fonts/,
	UprightFont = western/freefont/FreeSerif.otf,
    ItalicFont = western/freefont/FreeSerifItalic.otf,
    BoldFont = western/freefont/FreeSerifBold.otf,
    BoldItalicFont = western/freefont/FreeSerifBoldItalic.otf
]

% then our interchar transition rules

\XeTeXinterchartokenstate = 1

% We need special instructions for some of the more problematic characters and symbols

\XeTeXcharclass `\︑ 3	% vertical writing Japanese comma
\XeTeXcharclass `\︒ 3	% vertical writing Japanese full stop
\XeTeXcharclass `⁝ 3	% vertical writing ellipsis (technically, tricolon)

% Several characters from CJK ideographs extension A are used, so they need to be visible

\XeTeXcharclass `\⺾ 4
\XeTeXcharclass `\乀 4
\XeTeXcharclass `\丂 4
\XeTeXcharclass `\丮 4
\XeTeXcharclass `\兦 4
\XeTeXcharclass `\乴 4
\XeTeXcharclass `\檥 4
\XeTeXcharclass `\「 4	% HAN NOM A has better kerning for these characters
\XeTeXcharclass `\」 4
\XeTeXcharclass `〃 4	% and HAN NOM A just looks better for the idem ditto mark

% The same goes for a few characters from the CJK ideographs extension B block

\XeTeXcharclass `\𠃍 5	% L shape with the corner in the upper right
\XeTeXcharclass `\︴ 5	% vertical wavy line

% We use a separate class for CJK strokes

\XeTeXcharclass `\㇀ 10
\XeTeXcharclass `\㇏ 10
\XeTeXcharclass `\㇁ 10
\XeTeXcharclass `\㇂ 10
\XeTeXcharclass `\㇉ 10
\XeTeXcharclass `\㇈ 10
\XeTeXcharclass `\㇋ 10
\XeTeXcharclass `\㇌ 10
\XeTeXcharclass `\㇄ 10
\XeTeXcharclass `\㇅ 10
\XeTeXcharclass `\㇇ 10
\XeTeXcharclass `\㇆ 10

% And one for quite a number of arrows... since they're not found in palatino linotype, so we can't rely on the latin font.

\XeTeXcharclass `\← 6
\XeTeXcharclass `\↑ 6
\XeTeXcharclass `\→ 6
\XeTeXcharclass `\↓ 6
\XeTeXcharclass `\↔ 6
\XeTeXcharclass `\↕ 6
\XeTeXcharclass `\↖ 6
\XeTeXcharclass `\↗ 6
\XeTeXcharclass `\↘ 6
\XeTeXcharclass `\↙ 6

% Then some very special characters... vertical parentheses!

\XeTeXcharclass `\⁀ 7	% actually nowhere near the CJK blocks
\XeTeXcharclass `\‿ 7


% And of course, no book is complete without proper unicode quotation marks

\XeTeXcharclass `\‘ 8
\XeTeXcharclass `\’ 8
\XeTeXcharclass `\‚ 8
\XeTeXcharclass `\‛ 8
\XeTeXcharclass `\“ 8
\XeTeXcharclass `\” 8
\XeTeXcharclass `\„ 8
\XeTeXcharclass `\‟ 8

% To finish up, some particularly hard extended Latin block entries

\XeTeXcharclass `\ǒ 9	% o with caron (used in Pinyin orthography for Chinese)
\XeTeXcharclass `\′ 9	% prime and double prime for time (minute/second)
\XeTeXcharclass `\″ 9

\XeTeXcharclass `\⅓ 9		% 1/3
\XeTeXcharclass `\⅔ 9		% 2/3
\XeTeXcharclass `\⅕ 9		% 1/5
\XeTeXcharclass `\⅖ 9		% 2/5
\XeTeXcharclass `\⅗ 9		% 3/5
\XeTeXcharclass `\⅘ 9		% 4/5
\XeTeXcharclass `\⅙ 9		% 1/6
\XeTeXcharclass `\⅚ 9		% 5/6
\XeTeXcharclass `\⅛ 9		% 1/8
\XeTeXcharclass `\⅜ 9		% 3/8
\XeTeXcharclass `\⅝ 9		% 5/8
\XeTeXcharclass `\⅞ 9		% 7/8

% Then, we define all the transition rules that should occur when going from one class to another:

% when going to latin

\XeTeXinterchartoks \cjkideographs 0 = {\rmfont }
\XeTeXinterchartoks \cjkhiragana 0 = {\rmfont }
\XeTeXinterchartoks \cjkkatakana 0 = {\rmfont }
\XeTeXinterchartoks 4 0 = {\rmfont }
\XeTeXinterchartoks 5 0 = {\rmfont }
\XeTeXinterchartoks 6 0 = {\rmfont }
\XeTeXinterchartoks 7 0 = {\rmfont }
\XeTeXinterchartoks 8 0 = {\rmfont }
\XeTeXinterchartoks 9 0 = {\rmfont }
\XeTeXinterchartoks 10 0 = {\rmfont }
\XeTeXinterchartoks 4095 0 = {\rmfont }

% when going to CJK ideographs

\XeTeXinterchartoks 0 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks \cjkhiragana \cjkideographs = {\cjkfont }
\XeTeXinterchartoks \cjkkatakana \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 4 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 5 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 6 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 7 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 8 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 9 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 10 \cjkideographs = {\cjkfont }
\XeTeXinterchartoks 4095 \cjkideographs = {\cjkfont }

% when going to Hiragana

\XeTeXinterchartoks 0 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks \cjkideographs \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks \cjkkatakana \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 4 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 5 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 6 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 7 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 8 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 9 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 10 \cjkhiragana = {\cjkfont }
\XeTeXinterchartoks 4095 \cjkhiragana = {\cjkfont }

% when going to Katakana

\XeTeXinterchartoks 0 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks \cjkideographs \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks \cjkhiragana \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 4 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 5 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 6 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 7 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 8 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 9 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 10 \cjkkatakana = {\cjkfont }
\XeTeXinterchartoks 4095 \cjkkatakana = {\cjkfont }

% class '4' rules (CJK ideographs extension A)

\XeTeXinterchartoks 0 4 = {\cjkafont }
\XeTeXinterchartoks \cjkideographs 4 = {\cjkafont }
\XeTeXinterchartoks \cjkhiragana 4 = {\cjkafont }
\XeTeXinterchartoks \cjkkatakana 4 = {\cjkafont }
\XeTeXinterchartoks 5 4 = {\cjkafont }
\XeTeXinterchartoks 6 4 = {\cjkafont }
\XeTeXinterchartoks 7 4 = {\cjkafont }
\XeTeXinterchartoks 8 4 = {\cjkafont }
\XeTeXinterchartoks 9 4 = {\cjkafont }
\XeTeXinterchartoks 10 4 = {\cjkafont }
\XeTeXinterchartoks 4095 4 = {\cjkafont }

% class '5' rules (CJK ideographs extension B)

\XeTeXinterchartoks 0 5 = {\cjkbfont }
\XeTeXinterchartoks \cjkideographs 5 = {\cjkbfont }
\XeTeXinterchartoks \cjkhiragana 5 = {\cjkbfont }
\XeTeXinterchartoks \cjkkatakana 5 = {\cjkbfont }
\XeTeXinterchartoks 4 5 = {\cjkbfont }
\XeTeXinterchartoks 6 5 = {\cjkbfont }
\XeTeXinterchartoks 7 5 = {\cjkbfont }
\XeTeXinterchartoks 8 5 = {\cjkbfont }
\XeTeXinterchartoks 9 5 = {\cjkbfont }
\XeTeXinterchartoks 10 5 = {\cjkbfont }
\XeTeXinterchartoks 4095 5 = {\cjkbfont }

% class '6' rules (arrows)

\XeTeXinterchartoks 0 6 = {\arrowfont }
\XeTeXinterchartoks \cjkideographs 6 = {\arrowfont }
\XeTeXinterchartoks \cjkhiragana 6 = {\arrowfont }
\XeTeXinterchartoks \cjkkatakana 6 = {\arrowfont }
\XeTeXinterchartoks 4 6 = {\arrowfont }
\XeTeXinterchartoks 5 6 = {\arrowfont }
\XeTeXinterchartoks 7 6 = {\arrowfont }
\XeTeXinterchartoks 8 6 = {\arrowfont }
\XeTeXinterchartoks 9 6 = {\arrowfont }
\XeTeXinterchartoks 10 6 = {\arrowfont }
\XeTeXinterchartoks 4095 6 = {\arrowfont }

% class '7' rules (only used for vertical parentheses)

\XeTeXinterchartoks 0 7 = {\vparens }
\XeTeXinterchartoks \cjkideographs 7 = {\vparens }
\XeTeXinterchartoks \cjkhiragana 7 = {\vparens }
\XeTeXinterchartoks \cjkkatakana 7 = {\vparens }
\XeTeXinterchartoks 4 7 = {\vparens }
\XeTeXinterchartoks 5 7 = {\vparens }
\XeTeXinterchartoks 6 7 = {\vparens }
\XeTeXinterchartoks 8 7 = {\vparens }
\XeTeXinterchartoks 9 7 = {\vparens }
\XeTeXinterchartoks 10 7 = {\vparens }
\XeTeXinterchartoks 4095 7 = {\vparens }

% class '8' rules (unicode quotation marks - palatino's are quite horrible)

\XeTeXinterchartoks 0 8 = {\quotefont }
\XeTeXinterchartoks \cjkideographs 8 = {\quotefont }
\XeTeXinterchartoks \cjkhiragana 8 = {\quotefont }
\XeTeXinterchartoks \cjkkatakana 8 = {\quotefont }
\XeTeXinterchartoks 4 8 = {\quotefont }
\XeTeXinterchartoks 5 8 = {\quotefont }
\XeTeXinterchartoks 6 8 = {\quotefont }
\XeTeXinterchartoks 7 8 = {\quotefont }
\XeTeXinterchartoks 9 8 = {\quotefont }
\XeTeXinterchartoks 10 8 = {\quotefont }
\XeTeXinterchartoks 4095 8 = {\quotefont }

% class '9' rules (extended latin - FreeSerif chosen because it's closest to Palatino Linotype)

\XeTeXinterchartoks 0 9 = {\extlatinfont }
\XeTeXinterchartoks \cjkideographs 9 = {\extlatinfont }
\XeTeXinterchartoks \cjkhiragana 9 = {\extlatinfont }
\XeTeXinterchartoks \cjkkatakana 9 = {\extlatinfont }
\XeTeXinterchartoks 4 9 = {\extlatinfont }
\XeTeXinterchartoks 5 9 = {\extlatinfont }
\XeTeXinterchartoks 6 9 = {\extlatinfont }
\XeTeXinterchartoks 7 9 = {\extlatinfont }
\XeTeXinterchartoks 8 9 = {\extlatinfont }
\XeTeXinterchartoks 10 9 = {\extlatinfont }
\XeTeXinterchartoks 4095 9 = {\extlatinfont }

% class '10' rules (CJK strokes)

\XeTeXinterchartoks 0 10 = {\strokefont }
\XeTeXinterchartoks \cjkideographs 10 = {\strokefont }
\XeTeXinterchartoks \cjkhiragana 10 = {\strokefont }
\XeTeXinterchartoks \cjkkatakana 10 = {\strokefont }
\XeTeXinterchartoks 4 10 = {\strokefont }
\XeTeXinterchartoks 5 10 = {\strokefont }
\XeTeXinterchartoks 6 10 = {\strokefont }
\XeTeXinterchartoks 7 10 = {\strokefont }
\XeTeXinterchartoks 8 10 = {\strokefont }
\XeTeXinterchartoks 9 10 = {\strokefont }
\XeTeXinterchartoks 4095 10 = {\strokefont }
